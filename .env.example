# ===== 通用客户信息管理系统 环境变量配置 =====
# 本地开发复制为 .env 后修改；生产通过 docker compose / -e 注入

# SQLite 数据库连接串
# 本地开发（相对路径，数据落在项目 ./data 目录）
DATABASE_URL=sqlite:///./data/cims.db
# Docker 容器内请使用：sqlite:////data/cims.db

# JWT 签名密钥（生产环境务必改成随机长字符串，例如：openssl rand -hex 32）
SECRET_KEY=change-me-to-a-long-random-secret

# 后台管理员初始账号/密码（仅在用户表为空时自动初始化）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 外部集成 API Token（无 UI，修改此值并重启即完成更换）
API_TOKEN=change-me-please-use-a-long-random-token

# JWT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 跨域允许来源，多个用逗号分隔；* 表示允许全部（解耦的独立前端部署时配置）
CORS_ORIGINS=*

# 仅 docker-compose 部署用：GHCR 镜像地址（替换为你的 GitHub 用户名/仓库名）
IMAGE_URL=ghcr.io/你的用户名/你的仓库名:latest
