# ===== 通用客户信息管理系统 环境变量配置 =====
# 本地开发复制为 .env 后修改；生产通过 docker compose / -e 注入

# SQLite 数据库连接串
# 本地开发（相对路径，数据落在项目 ./data 目录）
DATABASE_URL=sqlite:///./data/cims.db
# Docker 容器内请使用：sqlite:////data/cims.db

# JWT 签名密钥（生产环境务必改成随机长字符串，例如：openssl rand -hex 32）
SECRET_KEY=change-me-to-a-long-random-secret

# 后台管理员初始账号/密码（仅在用户表为空时自动初始化）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 外部集成 API Token（无 UI，修改此值并重启即完成更换）
API_TOKEN=change-me-please-use-a-long-random-token

# JWT 有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 跨域允许来源，多个用逗号分隔；* 表示允许全部（解耦的独立前端部署时配置）
CORS_ORIGINS=*

# ===== 邮件提醒（可选）=====
# 客户提交表单后是否发邮件，由后台“项目设置”中的开关与收件人决定；
# 此处只配置 SMTP 服务能力。留空 SMTP_HOST 表示不启用邮件。
# 修改后需重启服务生效。
#
# 常见服务商（以实际服务商文档为准）：
#   QQ 邮箱：      smtp.qq.com      465(ssl)   密码填“授权码”
#   163 邮箱：     smtp.163.com     465(ssl)   密码填“授权码”
#   阿里企业邮箱： smtp.qiye.aliyun.com 465(ssl)
#   Gmail：        smtp.gmail.com   587(starttls)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# 发件人地址，留空则与 SMTP_USER 相同
SMTP_FROM=
# 加密方式：ssl（465）/ starttls（587）/ none
SMTP_SECURITY=ssl
SMTP_TIMEOUT=15

# 仅 docker-compose 部署用：GHCR 镜像地址（替换为你的 GitHub 用户名/仓库名）
IMAGE_URL=ghcr.io/你的用户名/你的仓库名:latest

# 仅 docker-compose 部署用：宿主机对外访问端口（容器内固定 8000），默认 8000
# 自动部署时由 GitHub Secret APP_PORT 注入；手动部署时在 .env 中设置即可
APP_PORT=8000
